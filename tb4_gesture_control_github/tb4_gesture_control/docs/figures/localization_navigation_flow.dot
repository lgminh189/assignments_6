digraph NavFlow {
  graph [rankdir=LR, bgcolor="white", pad="0.18", nodesep="0.24", ranksep="0.48", splines=ortho, fontname="DejaVu Sans", label="TỪ BẢN ĐỒ VÀ GOAL ĐẾN CHUYỂN ĐỘNG ROBOT", labelloc=t, fontsize=17, fontcolor="#174A6E"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, margin="0.14,0.08", color="#3D7894", penwidth=1.3, fillcolor="#EAF3F7", fontcolor="#17384B"];
  edge [fontname="DejaVu Sans", fontsize=8.5, color="#527C8B", penwidth=1.4, arrowsize=0.7];
  map [label="final_map.yaml\n+ .pgm", fillcolor="#E7F3EA", color="#54815A"];
  sensors [label="/scan + /odom\n+ TF", fillcolor="#E9F2E6", color="#71956B"];
  amcl [label="map_server + AMCL\npose robot trong map", fillcolor="#DDEBF4", color="#286884", penwidth=1.8];
  goal [label="RViz\nNav2 Goal", fillcolor="#FFF4D9", color="#B38A34"];
  global [label="Global costmap\n+ NavFn"];
  local [label="Local costmap\n+ MPPI", fillcolor="#DDEBF4", color="#286884", penwidth=1.8];
  safe [label="Smoother + collision\nmonitor"];
  robot [label="/cmd_vel_nav\ncontroller → robot", fillcolor="#E7F3EA", color="#54815A", penwidth=1.8];
  {rank=same; map; sensors}
  map -> amcl;
  sensors -> amcl;
  map -> global;
  amcl -> global;
  goal -> global;
  global -> local [label="đường đi"];
  sensors -> local [label="vật cản gần", constraint=false];
  local -> safe;
  safe -> robot;
}
