<?xml version="1.0"?>
<sdf version="1.9">
  <world name="gesture_arena">
    <physics type="ode"><max_step_size>0.003</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <scene><ambient>0.8 0.8 0.8 1</ambient><background>0.3 0.5 0.7 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -1</direction><cast_shadows>false</cast_shadows></light>
    <model name="floor"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
    </link></model>
    <model name="walls"><static>true</static><link name="link">
      <collision name="north"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <visual name="north"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></visual>
      <collision name="south"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <visual name="south"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></visual>
      <collision name="east"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.2 1</size></box></geometry></collision>
      <visual name="east"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.2 1</size></box></geometry></visual>
      <collision name="west"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.2 1</size></box></geometry></collision>
      <visual name="west"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.2 1</size></box></geometry></visual>
    </link></model>
  </world>
</sdf>
